#!/bin/bash
# flabel-run — label a capture on the replay box.
#
#   flabel-run <capture.pcap | gs://bucket/path.pcap> [extra flabel args]
#
# Exists because a tier-1 run needs three things the bare command does not carry: root (tcpreplay
# opens raw sockets), /usr/local/bin on PATH under sudo (where zeek is symlinked), and the device
# settings from /var/lib/flabel/flabel.env. Getting any of them wrong fails late — after a replay
# and a 60s settle have already been spent — so they are set in one place instead of remembered.
set -euo pipefail

# Overridable so the tests can drive this without /opt or /var, and so a second lab does not
# need a forked copy. Defaults are what the provisioning script lays down.
CONF="${FLABEL_RUN_CONF:-/var/lib/flabel/flabel.env}"
CAPTURES="${FLABEL_RUN_CAPTURES:-/var/lib/flabel/captures}"
RUNS="${FLABEL_RUN_RUNS:-/var/lib/flabel/runs}"
REPO="${FLABEL_RUN_REPO:-/opt/flabel/repo}"

# The privilege wrapper, overridable for the same reason: a replay needs root for raw sockets,
# and a test must be able to observe the command WITHOUT running it as root or at all.
SUDO="${FLABEL_RUN_SUDO:-sudo}"

# Where a successful run is published (#134). Overridable so a second lab does not need a forked
# copy, and so the tests can point it at a stub that records instead of uploading.
#
# An EMPTY value switches publishing off entirely rather than being a broken destination. That is
# what lets this wrapper stay the one way to run flabel on the box even when there is no bucket to
# publish to — a second code path for "run but do not publish" is a second thing to keep correct.
RESULTS_URI="${FLABEL_RESULTS_URI-gs://pm-proto-496816-flabel-pcaps/results}"
GCLOUD="${FLABEL_RUN_GCLOUD:-gcloud}"

# **Every gcloud call runs as root, and that is not about file permissions.** Measured on
# fl-replay 2026-08-19: only root's gcloud holds the instance service-account credential. The
# invoking user's active account was `craig@deeptempo.ai` with no valid token on the box, so
# `gcloud storage cp` failed with "select an already authenticated account" — while `sudo gcloud`
# worked, as the service account IAM was actually granted to.
#
# It is the identity that needs root, not the files: run directories are root-owned but 0755, so
# `tar` reads them fine unprivileged and is deliberately left unprivileged.
#
# Overridable and separate from $SUDO so the tests can run a stub gcloud directly. $SUDO is
# pointed at a recorder that never executes, which is right for the replay and useless here.
#
# Left UNQUOTED at both call sites, deliberately and following `$SUDO`'s own convention: an empty
# value has to expand to nothing so the command runs unwrapped, which quoting would turn into an
# attempt to execute the empty string. shellcheck flags this (SC2086) on the pre-existing `$SUDO`
# line too.
PUBLISH_SUDO="${FLABEL_RUN_PUBLISH_SUDO-$SUDO}"

#: Written to stdout and exit 0 for an explicit --help, to stderr and exit 2 for a usage error.
#: Those are different events: one is the operator asking, the other is the operator being told,
#: and a script that answers --help on stderr with a failing status cannot be piped into a pager.
usage() {
  cat <<'EOF'
flabel-run — label a packet capture on the replay box.

usage:
  flabel-run <capture.pcap | gs://bucket/object.pcap> [flabel args...]
  flabel-run --help

arguments:
  <capture>        A local path, absolute or relative, or a gs:// object. A gs:// object is
                   staged into /var/lib/flabel/captures first and reused if already there.
  [flabel args]    Anything after the capture is passed straight to flabel. Most useful:
                     (no flag)                  tier 1 only: replay past the firewall and label
                                                from its threat logs. This is the default.
                     --both                     tier 1 AND tier 2 — replay past the firewall and
                                                run Suricata, labelling from both. Slower: it
                                                loads ~85,000 rules on top of the replay.
                     --offline                  tier 2 only: no replay, no device, no network
                     --unmatched-threshold N    fail the run above this share unplaced (0.01)
                     --ruleset-snapshot ID      label against a specific snapshot. Tier 2 only,
                                                so it is refused without --both or --offline.
                     --output-dir DIR           override /var/lib/flabel/runs

                   Zeek runs whichever mode you pick — it is what flows are read from, not a
                   tier that can be switched off.

environment (anything you set here WINS over /var/lib/flabel/flabel.env):
  FLABEL_REPLAY_MULTIPLIER   time compression for the replay (default 1000). A 4h capture
                             replays in ~15s at 1000; lower it to replay closer to real time.
  FLABEL_REPLAY_TOPSPEED     1 to replay as fast as possible. Abandons relative packet
                             timing, so a 5-tuple occurring twice in one capture can no
                             longer be told apart and is reported unmatched rather than
                             guessed. Off by default for that reason.
  FLABEL_SETTLE_SECONDS      wait after the replay before clearing sessions (default 60).
                             Content-ID finishes a session after its last packet, so a
                             threat on the tail of a flow is logged after the replay returns.
  FLABEL_INLINE_HOST         firewall management address
  FLABEL_INLINE_API_KEY_FILE file holding the XML API key
  FLABEL_REPLAY_IF1/IF2      replay interfaces (default ens5, ens6)
  FLABEL_PLAIN_PROGRESS      1 to force one-line-per-step output instead of the live display
  NO_COLOR                   same effect, by convention
  FLABEL_RESULTS_URI         where a successful run is published as a tarball. Defaults to
                             gs://pm-proto-496816-flabel-pcaps/results. Set it EMPTY to run
                             without publishing at all.

output:
  One directory per run under /var/lib/flabel/runs/LABELED_{capture}_{timestamp}/ holding
  labels.json, run.json, NOTICE, zeek/ and suricata/. A run never modifies a previous
  one. A run that fails writes run.json and NO labels.json — the absence is the signal.

  LABELED_ marks who produced the directory; it does NOT mean labels are in it. The name is
  fixed before the run's outcome is known, so a failed run is named the same way.

  A run that wrote labels.json is also published to $FLABEL_RESULTS_URI as
  LABELED_{capture}_{timestamp}.tar.gz, unpacking to one directory of that name. A run
  with no labels.json is never published, so everything in that bucket has labels in it.
  If the upload fails the command exits non-zero and says so — the local run is untouched.

examples:
  flabel-run ./capture.pcap
  flabel-run gs://pm-proto-496816-flabel-pcaps/attackcollect/capture_2026-07-07.pcap
  flabel-run ./capture.pcap --both
  flabel-run ./capture.pcap --offline
  FLABEL_REPLAY_MULTIPLIER=200 FLABEL_SETTLE_SECONDS=30 flabel-run ./capture.pcap
EOF
}

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 2
    ;;
esac

TARGET="$1"; shift

[ -f "$CONF" ] || { echo "flabel-run: $CONF is missing; the device settings live there" >&2; exit 1; }

# The config file supplies DEFAULTS; anything already in the environment wins.
#
# `set -a; . "$CONF"` was the obvious way to do this and it is backwards: sourcing overwrites,
# so `FLABEL_SETTLE_SECONDS=15 flabel-run x.pcap` still settled for the file's 60 and gave no
# hint it had ignored you. Saving and restoring is uglier than sourcing and is the behaviour a
# caller expects from an environment variable.
_saved_env="$(export -p | grep -E '^(export |declare -x )FLABEL_' || true)"
# shellcheck disable=SC1090
set -a; . "$CONF"; set +a
eval "$_saved_env"

# A gs:// argument is staged locally first. flabel reads a file, and pulling it here keeps the
# fetch out of the timed part of the run — a slow download inside the replay window would widen
# the gap between the replay and the log query for no reason.
if [[ "$TARGET" == gs://* ]]; then
  mkdir -p "$CAPTURES"
  LOCAL="$CAPTURES/$(basename "$TARGET")"
  if [ -f "$LOCAL" ]; then
    echo "flabel-run: already staged at $LOCAL"
  else
    echo "flabel-run: fetching $TARGET"
    # Privileged for the same reason as the publish below, and this was already broken before
    # #134 — staging a gs:// capture as a user whose gcloud has no usable credential fails the
    # same way. Same defect, same one-line cause, fixed in the same breath rather than left as
    # the half of it nobody had tripped over yet.
    $PUBLISH_SUDO $GCLOUD storage cp "$TARGET" "$LOCAL"
  fi
  TARGET="$LOCAL"
fi

[ -f "$TARGET" ] || { echo "flabel-run: no such capture: $TARGET" >&2; exit 1; }

# Resolved to an absolute path BEFORE the cd below, which is the whole reason this line exists.
# The check above runs in the caller's directory; the command runs in $REPO. Without this,
# `flabel-run ./some.pcap` passes the check and then fails inside the repo — or, far worse,
# silently labels a different file that happens to share the name there.
TARGET="$(readlink -f -- "$TARGET")"

mkdir -p "$RUNS"

# Which directories exist BEFORE the run, so the one it creates can be identified afterwards
# (#134). Recorded here rather than re-deriving the name in bash: flabel's naming strips a chain
# of container suffixes and has a documented edge case for a capture called `.pcap` (#95), and a
# second implementation of that in shell is a second implementation that can disagree with it.
BEFORE="$(cd "$RUNS" && ls -1 2>/dev/null || true)"

cd "$REPO"
# NOT `exec` any more (#134). `exec` replaces this shell, so nothing could run after the labelling
# command — which is where publishing has to happen, because only a finished run has a directory
# to publish. The exit status is captured and re-raised at the end instead, so a failing run still
# fails the wrapper with flabel's own code.
#
# `set -e` is deliberately suspended around this one command. With it live, a non-zero flabel would
# kill the script here and the operator would lose the "no labels were written, details in ..."
# reporting below.
set +e
$SUDO -E env \
  PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
  FLABEL_INLINE_HOST="${FLABEL_INLINE_HOST:-}" \
  FLABEL_INLINE_API_KEY_FILE="${FLABEL_INLINE_API_KEY_FILE:-}" \
  FLABEL_REPLAY_IF1="${FLABEL_REPLAY_IF1:-ens5}" \
  FLABEL_REPLAY_IF2="${FLABEL_REPLAY_IF2:-ens6}" \
  FLABEL_REPLAY_MULTIPLIER="${FLABEL_REPLAY_MULTIPLIER:-1000}" \
  FLABEL_REPLAY_TOPSPEED="${FLABEL_REPLAY_TOPSPEED:-}" \
  FLABEL_SETTLE_SECONDS="${FLABEL_SETTLE_SECONDS:-60}" \
  uv run flabel "$TARGET" --output-dir "$RUNS" "$@"
STATUS=$?
set -e

# A publish failure must not turn a *failed* run into a differently-failed one: flabel's own exit
# code is the more useful diagnosis, so it wins. Spelled as a function rather than
# `${STATUS/#0/1}`, which is what this was first written as — every bug that has ever reached
# production in this wrapper was a one-liner nobody could read.
fail_if_run_succeeded() {
  if [ "$STATUS" = "0" ]; then
    STATUS=1
  fi
}

# --- publish (#134) ---------------------------------------------------------------------------
#
# Only a run that produced `labels.json` is published, and that is checked on the artifact rather
# than on `$STATUS`. The two agree today, and the file is the authority: issue #23 makes the
# presence of `labels.json` the definition of a completed run, so asking the directory what it
# holds cannot disagree with what a consumer will conclude from it. An exit code is a second
# record of the same fact, and this is the one the bucket's contents should follow.
publish() {
  local rundir="$1" name workdir tarball
  name="$(basename "$rundir")"

  if [ ! -f "$rundir/labels.json" ]; then
    echo "flabel-run: not publishing $name — it wrote no labels.json, so there is no result" >&2
    return 0
  fi

  # Built in a temporary directory, not inside $RUNS. A tarball written beside the run directories
  # is picked up as one by anything that lists them — including this script's own BEFORE/AFTER
  # comparison on the next run.
  # **`mktemp` is checked, and this is not defensive boilerplate.** The first version built the
  # path as mktemp's output interpolated directly into a string, so a failed mktemp yielded
  # `/$name.tar.gz` at the filesystem root — and the cleanups below, which then took the dirname of
  # that path, would have recursively deleted `/`. An unchecked command substitution two lines from
  # a recursive delete earns a guard; the cleanups now name the checked variable instead.
  workdir="$(mktemp -d)" || workdir=""
  if [ -z "$workdir" ] || [ ! -d "$workdir" ]; then
    echo "flabel-run: could not create a temporary directory; $rundir was not published" >&2
    return 1
  fi
  tarball="$workdir/$name.tar.gz"
  # `-C "$RUNS" "$name"` so the archive unpacks to a single directory of that name rather than to
  # whatever absolute path it happened to live at.
  #
  # `COPYFILE_DISABLE=1` is for the developer machines, not the box: bsdtar on macOS adds an
  # AppleDouble `._<name>` entry beside every real one, so the same run tarred on a laptop and on
  # Ubuntu produced archives with different contents. A no-op under GNU tar. Worth setting rather
  # than tolerating, because "the archive is the run directory" should not depend on who built it.
  if ! COPYFILE_DISABLE=1 tar -czf "$tarball" -C "$RUNS" "$name"; then
    echo "flabel-run: FAILED to build $tarball; $rundir is intact and was not published" >&2
    rm -rf "$workdir"
    return 1
  fi

  echo "flabel-run: publishing $name to $RESULTS_URI/"
  if ! $PUBLISH_SUDO $GCLOUD storage cp "$tarball" "$RESULTS_URI/$name.tar.gz"; then
    # Loud and non-zero. A silent failure here is the worst outcome available: the run succeeded,
    # the labels are on the box, and the operator believes they are in the bucket.
    echo "flabel-run: FAILED to publish $name to $RESULTS_URI/" >&2
    echo "flabel-run: the run itself SUCCEEDED — labels are intact at $rundir" >&2
    rm -rf "$workdir"
    return 1
  fi
  rm -rf "$workdir"
  echo "flabel-run: published $RESULTS_URI/$name.tar.gz"
  return 0
}

if [ -n "$RESULTS_URI" ]; then
  AFTER="$(cd "$RUNS" && ls -1 2>/dev/null || true)"
  # `comm` over two sorted lists rather than a glob: it names exactly what this invocation added,
  # so a concurrent run's directory is not mistaken for ours and a run that created nothing —
  # a rejected capture leaves no directory at all (spec §12) — yields nothing to publish.
  NEW="$(comm -13 <(printf '%s
' "$BEFORE" | sort) <(printf '%s
' "$AFTER" | sort) | sed '/^$/d')"
  COUNT="$(printf '%s
' "$NEW" | sed '/^$/d' | wc -l | tr -d ' ')"

  if [ "$COUNT" = "1" ] && [ -d "$RUNS/$NEW" ]; then
    publish "$RUNS/$NEW" || fail_if_run_succeeded
  elif [ "$COUNT" = "0" ]; then
    # Normal for a rejected capture, and for a failure before the directory could be created.
    # Not an error, and not silent: "nothing was published" is worth one line.
    echo "flabel-run: no new run directory under $RUNS — nothing to publish" >&2
  else
    # Refused rather than guessed. Publishing the wrong directory puts one capture's labels in the
    # bucket under another's name, which is worse than publishing nothing.
    echo "flabel-run: $COUNT new directories under $RUNS; cannot tell which is this run's," >&2
    echo "flabel-run: so nothing was published. Publish by hand:" >&2
    echo "flabel-run:   tar -czf - -C $RUNS <d> | $PUBLISH_SUDO $GCLOUD storage cp - $RESULTS_URI/<d>.tar.gz" >&2
    fail_if_run_succeeded
  fi
fi

exit "$STATUS"
