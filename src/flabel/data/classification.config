# flabel's own Suricata classification file. Passed with `--set classification-file=`.
#
# WHY THIS FILE IS OURS, AND WHY IT LOOKS LIKE THIS
#
# Suricata ships a `classification.config` under GPL-2.0-only. flabel is a public repository and
# does not redistribute it (Craig, 2026-08-12), so this is a flabel-authored file listing only
# the classtypes the nine admitted feeds actually use - enumerated from a real 85,545-rule
# snapshot, not copied from upstream's list.
#
# **The description field is the classtype name itself, deliberately.** Two reasons:
#
#   1. No third-party wording is reproduced. Upstream's descriptions ("A Network Trojan was
#      detected") are its text, and inventing replacements would put flabel's words in a feed's
#      mouth.
#   2. Nothing reads them. A label's `classtype` comes from the rule's own `classtype:` keyword
#      inside the hashed snapshot (`suricata.rule_classtypes`), never from eve.json's
#      `alert.category` - which is only this file's description, looked up by name. So the text
#      here reaches no label, and making it the name keeps `eve.json` self-explanatory for
#      whoever reads the retained output.
#
# The priority column is 3 for every entry - the engine's own default. flabel does not use
# `alert.severity` for anything, and ranking these classtypes would assert a severity judgement
# nobody has made. A rule carrying its own `priority:` keyword overrides it regardless.
#
# A classtype missing from this file is NOT fatal: measured on 8.0.6, Suricata warns once and
# loads the rule with priority 3. Since `classtype` is read from the rule text, a missing entry
# costs nothing but a log line - which is why this list can stay short, and why a feed adding a
# classtype tomorrow cannot break a run.
#
# Regenerate after a feed adds one:
#   uv run python tests/fixtures/rules/measure_feeds.py --mirror <dir> --snapshot <root>
#   then enumerate `classtype:` from that snapshot's rules.rules.
#
# Suricata rejects a trailing comment on a `config classification:` line — measured: every
# line of an earlier version of this file carrying one was refused with "Invalid Classtype".
# So the measured rule counts live here instead, newest measurement first:
#
#   attempted-admin                1138
#   attempted-dos                    16
#   attempted-recon                  92
#   attempted-user                  331
#   bad-unknown                     684
#   coin-mining                      36
#   command-and-control            2187
#   credential-theft                270
#   default-login-attempt             1
#   denial-of-service                 7
#   domain-c2                      6883
#   exploit-kit                     362
#   external-ip-check                35
#   misc-activity                   274
#   misc-attack                      17
#   network-scan                      2
#   not-suspicious                    4
#   policy-violation                438
#   protocol-command-decode           1
#   pup-activity                      7
#   shellcode-detect                 29
#   social-engineering              656
#   successful-admin                 22
#   successful-recon-limited          1
#   successful-user                   1
#   suspicious-filename-detect        2
#   suspicious-login                  4
#   targeted-activity               626
#   trojan-activity               59329
#   web-application-activity         50
#   web-application-attack         1091
#
# config classification: shortname,description,priority
config classification: attempted-admin,attempted-admin,3
config classification: attempted-dos,attempted-dos,3
config classification: attempted-recon,attempted-recon,3
config classification: attempted-user,attempted-user,3
config classification: bad-unknown,bad-unknown,3
config classification: coin-mining,coin-mining,3
config classification: command-and-control,command-and-control,3
config classification: credential-theft,credential-theft,3
config classification: default-login-attempt,default-login-attempt,3
config classification: denial-of-service,denial-of-service,3
config classification: domain-c2,domain-c2,3
config classification: exploit-kit,exploit-kit,3
config classification: external-ip-check,external-ip-check,3
config classification: misc-activity,misc-activity,3
config classification: misc-attack,misc-attack,3
config classification: network-scan,network-scan,3
config classification: not-suspicious,not-suspicious,3
config classification: policy-violation,policy-violation,3
config classification: protocol-command-decode,protocol-command-decode,3
config classification: pup-activity,pup-activity,3
config classification: shellcode-detect,shellcode-detect,3
config classification: social-engineering,social-engineering,3
config classification: successful-admin,successful-admin,3
config classification: successful-recon-limited,successful-recon-limited,3
