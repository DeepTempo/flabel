# Copy to .env and fill in. .env is gitignored — this repo is public.
# Never commit real project IDs, hostnames, or credentials.

# GCP project the lab environment is built in
GCP_PROJECT=

# Inline inspection device (PANW VM-Series) — management endpoint + API key
FLABEL_INLINE_HOST=
FLABEL_INLINE_API_KEY=

# Open-source IDS host (Snort/Suricata)
FLABEL_IDS_HOST=
