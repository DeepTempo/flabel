# Local-only: GCP teardown manifests (IAM, service accounts, network topology)
archive/

# Ruleset snapshots and run state (default --rules-dir root, docs/spec.md §7)
.flabel/

# Capture data and tool output — never in git
*.pcap
*.pcapng
*.cap
*.log
zeek/

# Narrow exception: test fixtures (PRD §10 fixture strategy). The broad rules above
# still apply everywhere else. Only synthetic captures and explicitly-licensed public
# captures may live here — never real traffic. The directory patterns must be
# re-included before the files inside them can be.
!tests/fixtures/**/zeek/
!tests/fixtures/**/*.pcap
!tests/fixtures/**/*.pcapng
!tests/fixtures/**/*.log

# Secrets / config
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
